{
  "name": "dsh-payroll-audit",
  "version": "0.1.4",
  "description": "按已核实的社保/公积金/个税参数核对工资表，逐条给出差异与依据，不代申报。",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "locale/*.json",
    "icon.svg",
    "rules",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/assets/*",
    "samples",
    "TROUBLESHOOTING.md",
    "screenshots.json",
    "capability.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "check:lockfile": "node scripts/check-lockfile-drift.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run verify:self-contained && pnpm run check:lockfile && pnpm run check:citations",
    "prepare": "tsdown",
    "check:citations": "node scripts/check-citations.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input/payroll-2026-07.csv",
      "prompt": "用自带样例核对一张工资表，告诉我哪些人不通过、未核验项和参数缺口各有多少。",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "工资表（.csv）"
      ],
      "writes": [],
      "network": false,
      "external": []
    },
    "capabilities": [
      "tools:register"
    ],
    "labels": []
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "payroll",
    "social"
  ],
  "author": {
    "name": "PerryLink"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-payroll-audit.git"
  },
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-payroll-audit/issues"
  },
  "homepage": "https://github.com/PerryLink/dsh-payroll-audit#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.1",
    "vitest": "^3.2.7",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dsh-table-ingest": "^0.2.1"
  }
}
